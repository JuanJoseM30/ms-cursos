# Copie este archivo como .env y ajuste los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

PORT=3011
HOST=127.0.0.1

# Base de datos MySQL de este microservicio
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cursos_db
DB_USER=cursos_user
DB_PASSWORD=una-clave-segura

# La MISMA clave JWT_SECRET que tiene ms-usuarios en su .env
JWT_SECRET=cambie-esta-frase-por-la-de-ms-usuarios
